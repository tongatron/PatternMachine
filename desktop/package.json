{
  "name": "patternmachine-desktop",
  "productName": "PatternMachine",
  "version": "0.1.0",
  "description": "PatternMachine come app per macOS: MIDI virtuale verso Logic, sync al clock di Logic, trascinamento e salvataggio su file",
  "main": "main.js",
  "private": true,
  "author": "Giovanni Bindi",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac dir"
  },
  "dependencies": {
    "@julusian/midi": "^3.8.1"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "org.tongatron.patternmachine",
    "productName": "PatternMachine",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "bridge/**", "package.json"],
    "extraResources": [
      { "from": "../site", "to": "site", "filter": ["**/*", "!sw.js", "!**/.DS_Store"] }
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "../site/icons/icon-512.png",
      "identity": null
    }
  }
}
